---
apiVersion: v1
kind: Secret
metadata:
  name: holuser-bootstrap-secret
  namespace: acme-east-prod-wrp4h
stringData:
  holuser-passwd: $6$rounds=4096$7cDhaZxJV5sAdxGA$G5xkGvumaYxdhkBc4YTADb3PQUfMhfl8KoNnaX4fUcfW.bj3rk/JjwP2/nyvyVYoUCsXXNNc6aHaYnKD2DXon.
---
apiVersion: vmoperator.vmware.com/v1alpha5
kind: VirtualMachine
metadata:
  labels:
    vm.name: db-vm
  name: mysql-db
  namespace: acme-east-prod-wrp4h
spec:
  image:
    kind: VirtualMachineImage
    name: vmi-87df22712c2523e9c
  className: best-effort-small
  powerState: PoweredOn
  storageClass: cluster-wld01-01a-optimal-datastore-default-policy-autoraid
  # spec.network.interfaces[].network{apiVersion,kind,name} is the real VM
  # Operator v1alpha5 schema for attaching to a specific network -- confirmed
  # live via `kubectl explain virtualmachine.spec.network.interfaces.network`
  # against the Supervisor cluster (2026-08-29); it isn't documented anywhere
  # else in this repo or in any VCFA blueprint sample. subnet-public1 (see
  # k8s_manifests/subnet-public1.yaml) must already exist and be REALIZED
  # before this VM is created, or it will fail to get an IP.
  #
  # Because this VM sits on a public/routable subnet, it does NOT need a
  # VirtualMachineService (LoadBalancer VIP) in front of it the way a
  # default-private-network VM would -- see 2740-01-module_1.yaml's "Query
  # VirtualMachine for its assigned public-subnet IP" task, which reads the
  # VM's own status.network.primaryIP4 directly instead.
  network:
    interfaces:
      - name: eth0
        network:
          apiVersion: crd.nsx.vmware.com/v1alpha1
          kind: Subnet
          name: subnet-public1
  bootstrap:
    cloudInit:
      cloudConfig:
#cloud-config
        ssh_pwauth: true
        defaultUserEnabled: true
        users:
          - name: holuser
            gecos: holuser
            passwd:
              name: holuser-bootstrap-secret
              key: holuser-passwd
            lock_passwd: false
            sudo: "ALL=(ALL) NOPASSWD:ALL"
            groups: 
              - sudo
              - users
              - admin
            shell: /bin/bash
            ssh_authorized_keys:
              - ssh-rsa 

        write_files:
          - content: |
              ALTER USER 'root'@'localhost' IDENTIFIED WITH mysql_native_password BY '{{ db_password }}';
            append: true
            path: /alteruser.txt

          - content: |
              CREATE USER 'holuser'@'%' IDENTIFIED WITH mysql_native_password BY '{{ db_password }}';
              CREATE DATABASE demo;
              GRANT ALL PRIVILEGES ON demo.* TO 'holuser'@'%';

              CREATE TABLE demo.user (
                id INTEGER PRIMARY KEY AUTO_INCREMENT,
                username varchar(255) NOT NULL,
                password varchar(255) NOT NULL,
                UNIQUE (username)
              );


              CREATE TABLE demo.entry (
                id INTEGER PRIMARY KEY AUTO_INCREMENT,
                author_id INTEGER NOT NULL,
                created TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
                title varchar(255) NOT NULL,
                body varchar(5400) NOT NULL,
                FOREIGN KEY (author_id) REFERENCES user (id)
              );

              INSERT INTO demo.user (username,password) VALUES('holuser','{{ db_password }}');
              INSERT INTO demo.entry (author_id,title,body) VALUES(1,"Welcome to the request page, this is the first entry","This entry is owned by holuser and can only be modified by him. You can create your own post by registering and logging in!");

            append: true
            path: /init.sql

        runcmd:
          - "apt -o acquire::http::proxy=\"http://10.1.1.1:3128\" -o acquire::https::proxy=false update"
          - "apt -o acquire::http::proxy=\"http://10.1.1.1:3128\" -o acquire::https::proxy=false -y install mysql-server"
          - "systemctl start mysql.service"
          - "mysql < /alteruser.txt"
          - "mysql -u root -p'{{ db_password }}' < /init.sql"
          - "sed -i '0,/bind-address/s//#bind-address/' /etc/mysql/mysql.conf.d/mysqld.cnf"
          - "systemctl restart mysql.service"
          - "groupadd -f admingroup"
          - "usermod -aG admingroup root"
          - "usermod -aG admingroup sys"